# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Where form submissions are delivered.
# Multiple recipients: separate with commas (no spaces required).
RESEND_TO_EMAIL=your@email.com

# Verified sender address. Defaults to onboarding@resend.dev if unset,
# which can only deliver to your own Resend account address.
# Verify a custom domain to send to external recipients.
RESEND_FROM_EMAIL=onboarding@resend.dev